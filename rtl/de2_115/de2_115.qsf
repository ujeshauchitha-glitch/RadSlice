# Quartus settings for the DE2-115 build of the RadSlice core (rtl/de2_115/de2_115_top.v).
# Pin locations are copied from a published DE2-115 pin table (UNLV, eelabs.faculty.unlv.edu/docs/guides/DE2-115_Pin_Table.pdf)
# and checked against the extracted text by script; they have not been checked against Terasic's own manual.
# NOT YET BUILT OR RUN on a board. The 'Depending on JP7/JP6' pins are on a bank whose voltage is set by that jumper;
# 3.3-V LVTTL assumes the jumper is in its 3.3 V position. Check JP6 and JP7 on the board before programming.

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY de2_115_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE de2_115.sdc
set_global_assignment -name VERILOG_FILE de2_115_top.v
set_global_assignment -name VERILOG_FILE ../slice_unit.v
set_global_assignment -name VERILOG_FILE ../sliced_alu.v
set_global_assignment -name VERILOG_FILE ../sliced_regfile_serial.v
set_global_assignment -name VERILOG_FILE ../rv64i_core.v


set_location_assignment PIN_Y2 -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_location_assignment PIN_M23 -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[0]
set_location_assignment PIN_M21 -to KEY[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[1]
